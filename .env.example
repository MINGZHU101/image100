# ========== 生效配置（Windows 本机连虚拟机中间件）==========
APP_ENV=development
API_PORT=7302

# 虚拟机 PostgreSQL：宿主机端口 7311 → 容器 5432
DATABASE_URL=postgresql+asyncpg://retouch:retouch_dev@192.168.137.128:7311/retouch

# 虚拟机 Redis：宿主机端口 7312 → 容器 6379
REDIS_URL=redis://192.168.137.128:7312/0

# 前端 Vite 开发地址（逗号分隔）
CORS_ORIGINS=http://localhost:7301,http://127.0.0.1:7301

# ========== v2：本地存储 ==========
STORAGE_BACKEND=local
# 相对项目根目录 image100/
LOCAL_STORAGE_DIR=./data
# 上传大小上限：10MB
UPLOAD_MAX_BYTES=10485760

# ========== v3：去背策略（mock | rembg，本期仅 mock）==========
MATTING_PROVIDER=mock

# ========== 以下为后续版本预留（先注释）==========

# --- 鉴权（约 v8 / 增强）---
# JWT_SECRET=dev-only-secret-please-change-in-production
# JWT_TTL_HOURS=24

# --- 后续可切腾讯云 COS ---
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=ap-guangzhou
# COS_BUCKET=
# COS_PUBLIC_BASE_URL=

