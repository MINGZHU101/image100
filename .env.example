# ========== 生效配置（Windows 本机连虚拟机中间件）==========
APP_ENV=development
API_PORT=7302

# 虚拟机 PostgreSQL：宿主机端口 7311 → 容器 5432
DATABASE_URL=postgresql+asyncpg://retouch:retouch_dev@192.168.137.128:7311/retouch

# 虚拟机 Redis：宿主机端口 7312 → 容器 6379
REDIS_URL=redis://192.168.137.128:7312/0

# 前端 Vite 开发地址（逗号分隔）
CORS_ORIGINS=http://localhost:7301,http://127.0.0.1:7301

# ========== v8：对象存储（默认腾讯云 COS；可改 local）==========
STORAGE_BACKEND=cos
# 上传大小上限：10MB
UPLOAD_MAX_BYTES=10485760

# COS 四项（获取方式见 docs/腾讯云COS密钥与存储桶获取教程.md）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=your-bucket-1250000000

# 本机回退时改为 STORAGE_BACKEND=local，并启用下面两项
# STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=./data

# ========== v3：去背策略（mock | rembg，本期仅 mock）==========
MATTING_PROVIDER=mock

# ========== v10：鉴权 ==========
JWT_SECRET=dev-only-secret-please-change-in-production
JWT_TTL_HOURS=24
# v11 管理端默认账号（迁移种子，生产务必改密）：admin / admin123456
# Cookie：image100_session（用户）/ image100_admin_session（管理员）

# ========== v10：LangSmith（勿提交真实 Key）==========
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=image100

# ========== v4：Agent 规划器 ==========
# 默认 dashscope；前端另有 Mock / LLM 按钮可按次覆盖
PLANNER_PROVIDER=dashscope
# 推荐从系统环境变量读取 Key，勿提交真实 Key 到仓库
# DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PLANNER_MODEL=qwen-plus

# ========== v5：文生图 ==========
IMAGE_PROVIDER=dashscope
TEXT_TO_IMAGE_MODEL=qwen-image-3.0-pro
# 文生图原生接口（与规划器 compatible-mode 分开）
# DASHSCOPE_IMAGE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# --- 后续版本预留 ---
# IMAGE_PROVIDER=mock
# TEXT_TO_IMAGE_MODEL=qwen-image-3.0-pro
# IMAGE_EDIT_MODEL=qwen-image-edit-max
